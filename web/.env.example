# Optional. Without these, rx-scout runs on mock pharmacy data (no map).
# With a Google Maps JavaScript API key (Places library enabled), it shows
# real nearby pharmacies on an interactive map.
#
# Get a key: https://console.cloud.google.com/google/maps-apis
# Restrict it by HTTP referrer to your domain before deploying.
VITE_GOOGLE_MAPS_API_KEY=

# Optional Map ID for Advanced Markers (defaults to Google's DEMO_MAP_ID).
VITE_GOOGLE_MAP_ID=
